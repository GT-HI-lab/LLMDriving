# Copy this file to .env, replace the placeholder, and never commit .env.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# All study routes intentionally use the same identity and voice.
OPENAI_REALTIME_VOICE=marin
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_INPUT_LANGUAGE=en
OPENAI_SAFETY_IDENTIFIER=local-demo-user

# Optional Python CA bundle path for SSL verification.
# On a Python.org macOS install, uncomment and adapt this only if needed.
# SSL_CERT_FILE=/Library/Frameworks/Python.framework/Versions/3.8/lib/python3.8/site-packages/certifi/cacert.pem

APP_HOST=127.0.0.1
APP_PORT=8000

TLS_CERT_FILE=
TLS_KEY_FILE=
